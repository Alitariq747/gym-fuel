rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyAllowedKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isValidTimestamp(value) {
      return value is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // NOTE: `activityLevel`, not `nonTrainingActivityLevel`. The field was
      // renamed in Swift in commit 883ee7a ("gym vocab removed") and the rules
      // were not updated. Because `onlyAllowedKeys` uses hasOnly(), every profile
      // write carrying the new name was rejected — which meant onboarding could
      // not complete at all.
      allow create, update: if isOwner(uid)
        && onlyAllowedKeys([
          "name",
          "heightCm",
          "age",
          "weightKg",
          "goalType",
          "activityLevel",
          "isOnboardingComplete",
          "gender",
          "goalPace",
          "targetWeightKg",
          "createdAt",
          "updatedAt"
        ]);

      allow delete: if false;

      match /logEntries/{entryId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "id",
            "userId",
            "source",
            "status",
            "loggedAt",
            "type",
            "title",
            "rawInput",
            "detail",
            "feedback",
            "image",
            "imageUploadStatus",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.userId == uid;

        allow delete: if isOwner(uid);
      }

      match /savedMeals/{mealId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "id",
            "userId",
            "name",
            "description",
            "macros",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.userId == uid;

        allow delete: if isOwner(uid);
      }

      // One document per local calendar day, keyed "yyyy-MM-dd". `dateKey` is
      // asserted against the document ID the same way dailyMacroTargets does —
      // the path already carries the owner, so there is no `userId` field here.
      //
      // Deliberately no range check on `weightKg`. A rule stricter than the
      // client is the failure documented above: it fails silently, and this is
      // the one write the whole trend rests on.
      match /weighIns/{dateKey} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "dateKey",
            "weightKg",
            "loggedAt",
            "source",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.dateKey == dateKey;

        // Nothing in the app deletes a weigh-in: the sheet only ever writes
        // today's key, and same-day corrections overwrite. Relax this when the
        // check-in screen gains an edit affordance.
        allow delete: if false;
      }

      // One document per goal-and-pace stretch, keyed by the "yyyy-MM-dd" day it
      // started. `startDateKey` is asserted against the document ID, as on
      // weighIns. A same-day pace change overwrites the document; a later one
      // starts a new document.
      //
      // No delete: a phase is the history a check-in's target change is read
      // against, and the calorie adjustment on it is carried forward.
      match /phases/{startDateKey} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "startDateKey",
            "goalType",
            "goalPace",
            "pacePercentPerWeek",
            "startWeightKg",
            "targetWeightKg",
            "startTargets",
            "calorieAdjustment",
            "lastStepDecisionDateKey",
            "startedAt",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.startDateKey == startDateKey;

        allow delete: if false;
      }

      // One document per weekly check-in, keyed by the "yyyy-MM-dd" day it fell
      // due. Due dates only exist inside a phase (start + 7, + 14, …) and phase
      // keys only move forward, so a new phase never collides with an old record;
      // `phaseStartDateKey` says which phase a record belongs to.
      //
      // Update is allowed so a retried save overwrites rather than fails. No
      // delete: a check-in is the record of a target changing.
      match /checkIns/{dueDateKey} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "dueDateKey",
            "phaseStartDateKey",
            "decision",
            "response",
            "paceKgPerWeek",
            "goalKgPerWeek",
            "weighInCount",
            "windowDays",
            "loggedDays",
            "averageLoggedCalories",
            "suggestedDelta",
            "targetsBefore",
            "targetsAfter",
            "completedDateKey",
            "completedAt",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.dueDateKey == dueDateKey;

        allow delete: if false;
      }

      match /dailyMacroTargets/{dateKey} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "dateKey",
            "targetMacros",
            "goalType",
            "calculatorVersion",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.dateKey == dateKey;

        allow delete: if false;
      }
    }

    match /usageQuotas/{uid} {
      allow read, write: if false;

      match /monthly/{period} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
