rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyAllowedKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isValidTimestamp(value) {
      return value is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // NOTE: `activityLevel`, not `nonTrainingActivityLevel`. The field was
      // renamed in Swift in commit 883ee7a ("gym vocab removed") and the rules
      // were not updated. Because `onlyAllowedKeys` uses hasOnly(), every profile
      // write carrying the new name was rejected — which meant onboarding could
      // not complete at all.
      //
      // Step 4c adds the goal weight, the plan start and the saved targets.
      // Deploy these rules before running a build that writes them.
      allow create, update: if isOwner(uid)
        && onlyAllowedKeys([
          "name",
          "heightCm",
          "age",
          "weightKg",
          "goalType",
          "activityLevel",
          "isOnboardingComplete",
          "gender",
          "goalWeightKg",
          "planStartedOn",
          "planStartWeightKg",
          "targetCalories",
          "targetProteinG",
          "targetCarbsG",
          "targetFatG",
          "maintenanceCalories",
          "targetsSetOn",
          "targetsSetAtWeightKg",
          "createdAt",
          "updatedAt"
        ]);

      allow delete: if false;

      match /logEntries/{entryId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "id",
            "userId",
            "source",
            "status",
            "loggedAt",
            "type",
            "title",
            "rawInput",
            "detail",
            "feedback",
            "image",
            "imageUploadStatus",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.userId == uid;

        allow delete: if isOwner(uid);
      }

      match /savedMeals/{mealId} {
        allow read: if isOwner(uid);

        // Step 5 added `breakdown`, `assumptions` and `macrosProvenance` as
        // top-level fields on a saved meal. They were missing here, so every
        // save of a *logged* meal was rejected while a hand-typed one still
        // worked — a hand-typed meal leaves all three nil, and encoding omits
        // them. Same hasOnly() failure as the `activityLevel` note above.
        //
        // `logEntries` was unaffected because a breakdown lives inside the
        // `feedback` map there, and hasOnly() only inspects top-level keys.
        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "id",
            "userId",
            "name",
            "description",
            "macros",
            "breakdown",
            "assumptions",
            "macrosProvenance",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.userId == uid;

        allow delete: if isOwner(uid);
      }

      // One document per local calendar day, keyed "yyyy-MM-dd". `dateKey` is
      // asserted against the document ID the same way dailyMacroTargets does —
      // the path already carries the owner, so there is no `userId` field here.
      //
      // Deliberately no range check on `weightKg`. A rule stricter than the
      // client is the failure documented above: it fails silently, and this is
      // the one write the whole trend rests on.
      match /weighIns/{dateKey} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "dateKey",
            "weightKg",
            "loggedAt",
            "source",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.dateKey == dateKey;

        // Typed weigh-ins only: the Health import refills any day without a
        // row, so a deleted Health row would come back on the next open.
        allow delete: if isOwner(uid) && resource.data.source == "manual";
      }

      match /dailyMacroTargets/{dateKey} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && onlyAllowedKeys([
            "dateKey",
            "targetMacros",
            "goalType",
            "calculatorVersion",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.dateKey == dateKey;

        allow delete: if false;
      }
    }

    match /usageQuotas/{uid} {
      allow read, write: if false;

      match /monthly/{period} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
